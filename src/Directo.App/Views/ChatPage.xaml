<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Directo.Presentation.ViewModels;assembly=Directo.Presentation"
             x:Class="Directo.App.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Contacto" Command="{Binding OpenDetailsCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <VerticalStackLayout Padding="16,8" Spacing="2">
            <Label Text="{Binding ConnectionStatus}" Style="{StaticResource Caption}" />
            <Label x:Name="UnverifiedHint"
                   Text="Identidad sin verificar · compara el código de seguridad"
                   IsVisible="False"
                   Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <CollectionView x:Name="MessagesView"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageItemViewModel">
                    <Grid Padding="12,4">
                        <Border HorizontalOptions="{Binding IsOutgoing, Converter={StaticResource OutgoingAlignment}}"
                                BackgroundColor="{Binding IsOutgoing, Converter={StaticResource BubbleColor}}"
                                Style="{StaticResource Bubble}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Body}" />
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                    <Label Text="{Binding Time}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding StatusIcon}" Style="{StaticResource Caption}"
                                           SemanticProperties.Description="{Binding StatusDescription}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2" Padding="16,0" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" Style="{StaticResource Error}" />

        <Grid Grid.Row="3" Padding="12" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Editor Text="{Binding Draft}" Placeholder="Escribe un mensaje" AutoSize="TextChanges" MaximumHeightRequest="140" />
            <Button Grid.Column="1" Text="Enviar" Command="{Binding SendCommand}" VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>
