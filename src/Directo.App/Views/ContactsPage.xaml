<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Directo.Presentation.ViewModels;assembly=Directo.Presentation"
             xmlns:g="clr-namespace:Directo.App.Graphics"
             x:Class="Directo.App.Views.ContactsPage"
             x:DataType="vm:ContactsViewModel"
             Title="Directo">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <Grid Padding="20,28,20,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 11">
                <g:Icon Data="M6 5h6a7 7 0 0 1 0 14H6z" Stroke="White" StrokeThickness="2.6" />
            </Border>
            <Label Grid.Column="1" Text="Directo" Style="{StaticResource Title}" VerticalOptions="Center" />
            <Border Grid.Column="2" Style="{StaticResource IconButton}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    SemanticProperties.Description="Ajustes">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
                <g:Icon StrokeThickness="1.8"
                      Data="M12 15a3 3 0 1 0 0-6a3 3 0 1 0 0 6 M12 2v3 M12 19v3 M2 12h3 M19 12h3 M4.9 4.9l2.1 2.1 M17 17l2.1 2.1 M4.9 19.1l2.1-2.1 M17 7l2.1-2.1" />
            </Border>
        </Grid>

        <!-- Signaling status -->
        <Border Grid.Row="1" Margin="20,4,20,16" Style="{StaticResource Card}" Padding="14,10" StrokeShape="RoundRectangle 14">
            <HorizontalStackLayout Spacing="10">
                <Ellipse x:Name="SignalDot" WidthRequest="8" HeightRequest="8" Fill="{StaticResource OnlineDot}" VerticalOptions="Center" />
                <Label x:Name="SignalText" Text="Visible para tus contactos · el servidor no guarda nada" FontSize="13" Style="{StaticResource Muted}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <Grid Grid.Row="2" Padding="20,0,20,8" ColumnDefinitions="*,Auto">
            <Label Text="Conversaciones" Style="{StaticResource Overline}" />
            <Label Grid.Column="1" Text="{Binding Conversations.Count}" Style="{StaticResource Caption}" FontSize="13" />
        </Grid>

        <!-- Conversations -->
        <CollectionView x:Name="List" Grid.Row="3" Margin="12,0" ItemsSource="{Binding Conversations}" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="28,48" Spacing="14" VerticalOptions="Center">
                    <Border WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 24" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface2Light}, Dark={StaticResource Surface2Dark}}">
                        <g:Icon Data="M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h3v3 M21 14v.01 M14 21h3 M21 18v3" />
                    </Border>
                    <Label Text="Aún no tienes contactos" Style="{StaticResource Heading}" HorizontalTextAlignment="Center" />
                    <Label Text="Directo no usa tu número ni tu email. Reuníos y que uno escanee el código QR del otro." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationListItem">
                    <Grid Padding="10,12" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Grid WidthRequest="56" HeightRequest="56">
                            <Border Style="{StaticResource Avatar}" WidthRequest="52" HeightRequest="52" HorizontalOptions="Start" VerticalOptions="Start"
                                    BackgroundColor="{Binding AvatarColor, Converter={StaticResource HexColor}}">
                                <Label Text="{Binding Initials}" Style="{StaticResource Initials}" FontSize="19" />
                            </Border>
                            <Ellipse WidthRequest="16" HeightRequest="16" HorizontalOptions="End" VerticalOptions="End"
                                     StrokeThickness="3" Stroke="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}"
                                     Fill="{StaticResource OfflineDot}">
                                <Ellipse.Triggers>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ConnectingDot}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource OnlineDot}" />
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="{Binding DisplayName}" Style="{StaticResource Strong}" LineBreakMode="TailTruncation" />
                                <g:Icon Grid.Column="1" IsVisible="{Binding IsVerified}" Stroke="{StaticResource Accent}" StrokeThickness="2.2"
                                      Size="16" Data="M12 3l7 3v6c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V6z M9 12l2 2 4-4"
                                      SemanticProperties.Description="Verificado" />
                                <Label Grid.Column="3" Text="{Binding ActivityTime}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding Preview}" Style="{StaticResource Muted}" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding ConnectionStatus}" Style="{StaticResource Caption}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnlineTextLight}, Dark={StaticResource OnlineTextDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border Grid.Column="1" IsVisible="{Binding HasPending}" StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="8,2"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AmberSoftLight}, Dark={StaticResource AmberSoftDark}}">
                                    <Label Text="{Binding PendingCount, StringFormat='{0} pendientes'}" FontSize="12" FontFamily="DMSansSemiBold"
                                           TextColor="{AppThemeBinding Light={StaticResource AmberLight}, Dark={StaticResource AmberDark}}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Dock -->
        <Grid Grid.Row="4" Padding="20,14,20,24" ColumnDefinitions="*,*" ColumnSpacing="12" Style="{StaticResource Header}">
            <BoxView Grid.ColumnSpan="2" Style="{StaticResource Divider}" VerticalOptions="Start" Margin="-20,-14,-20,0" />
            <Button Text="Mostrar mi QR" Command="{Binding InviteCommand}" />
            <Button Grid.Column="1" Text="Escanear" Command="{Binding ScanCommand}" Style="{StaticResource SecondaryButton}" />
        </Grid>
    </Grid>
</ContentPage>
