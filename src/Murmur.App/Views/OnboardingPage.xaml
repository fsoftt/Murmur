<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Murmur.Presentation.ViewModels;assembly=Murmur.Presentation"
             xmlns:g="clr-namespace:Murmur.App.Graphics"
             x:Class="Murmur.App.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel">
    <Grid>
        <!-- Concentric "signal" rings -->
        <Ellipse WidthRequest="360" HeightRequest="360" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-120,-140,0" Stroke="{StaticResource Accent}" Opacity="0.22" StrokeThickness="1" />
        <Ellipse WidthRequest="240" HeightRequest="240" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-60,-80,0" Stroke="{StaticResource Accent}" Opacity="0.22" StrokeThickness="1" />
        <Ellipse WidthRequest="120" HeightRequest="120" HorizontalOptions="End" VerticalOptions="Start" Margin="0,0,-20,0" Stroke="{StaticResource Accent}" Opacity="0.22" StrokeThickness="1" />

        <ScrollView>
            <VerticalStackLayout Padding="24,64,24,32" Spacing="0">
                <Border WidthRequest="64" HeightRequest="64" HorizontalOptions="Start" BackgroundColor="{StaticResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <g:Icon Size="34" Stroke="White" StrokeThickness="2.4" Data="M6 10v4 M10 6v12 M14 8v8 M18 11v2" />
                </Border>
                <Label Margin="0,28,0,10" Style="{StaticResource Display}" FontSize="40" Text="Tus mensajes,&#10;de teléfono&#10;a teléfono." />
                <Label Margin="0,0,0,24" Style="{StaticResource Muted}" FontSize="16" Text="Sin cuentas, sin número, sin email. Antes de empezar, tres reglas que conviene conocer." />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{x:Static vm:OnboardingViewModel.Rules}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OnboardingRule">
                            <Border Style="{StaticResource Card}" Padding="14" StrokeShape="RoundRectangle 18">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border WidthRequest="36" HeightRequest="36" VerticalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface2Light}, Dark={StaticResource Surface2Dark}}">
                                        <Label Text="{Binding Number}" FontFamily="SpaceGroteskBold" HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource LinkLight}, Dark={StaticResource LinkDark}}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Title}" Style="{StaticResource Strong}" FontSize="15" />
                                        <Label Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="13" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Margin="0,28,0,6" Style="{StaticResource Caption}" FontSize="13" Text="Tu nombre (opcional, solo lo ve quien se empareja contigo)" />
                <Border Style="{StaticResource Card}" Padding="14,2" StrokeShape="RoundRectangle 14">
                    <Entry Text="{Binding ProfileName}" Placeholder="Nombre" MaxLength="40" />
                </Border>
                <Button Margin="0,16,0,10" Text="Crear mi identidad" Command="{Binding StartCommand}" HeightRequest="56" />
                <Label Text="Tus claves se crean y se quedan en este teléfono." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" Style="{StaticResource Error}" Margin="0,12,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
