<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Murmur.Presentation.ViewModels;assembly=Murmur.Presentation"
             xmlns:g="clr-namespace:Murmur.App.Graphics"
             x:Class="Murmur.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Ajustes">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="10,24,10,8" ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Border Style="{StaticResource IconButton}" SemanticProperties.Description="Volver">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <g:Icon StrokeThickness="2.2" Data="M15 6L9 12L15 18" />
            </Border>
            <Label Grid.Column="1" Text="Ajustes" Style="{StaticResource Heading}" FontSize="20" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,28" Spacing="16">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tu nombre" Style="{StaticResource Heading}" FontSize="17" />
                        <Label Text="Opcional. Solo lo ve quien se empareja contigo. Nunca se envía al servidor." Style="{StaticResource Muted}" FontSize="13" />
                        <Border Padding="14,2" StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">
                            <Entry Text="{Binding ProfileName}" Placeholder="Nombre" MaxLength="40" />
                        </Border>
                        <Button Text="Guardar" Command="{Binding SaveCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding AvailabilitySupported}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Siempre disponible" Style="{StaticResource Heading}" FontSize="17" VerticalOptions="Center" />
                            <Switch x:Name="AlwaysAvailableSwitch" Grid.Column="1" IsToggled="{Binding AlwaysAvailable, Mode=OneWay}" Toggled="OnAlwaysAvailableToggled" />
                        </Grid>
                        <Label Style="{StaticResource Muted}" FontSize="13"
                               Text="Tus contactos pueden enviarte mensajes aunque tengas la app cerrada. Android mostrará un aviso permanente y gastará algo más de batería. Nada se guarda en el servidor: tu teléfono sigue siendo el que recibe." />
                        <Border IsVisible="{Binding ShowBatteryWarning}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AmberSoftLight}, Dark={StaticResource AmberSoftDark}}">
                            <VerticalStackLayout Spacing="8">
                                <Label FontSize="13" TextColor="{AppThemeBinding Light={StaticResource AmberLight}, Dark={StaticResource AmberDark}}"
                                       Text="Android puede pausar Murmur para ahorrar batería. Para que sea fiable, quítalo de la optimización de batería." />
                                <Button Text="Abrir ajustes de batería" Style="{StaticResource SecondaryButton}" Command="{Binding OpenBatterySettingsCommand}" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Style="{StaticResource Caption}"
                               Text="Aunque esté desactivado, Murmur intenta enviar tus mensajes pendientes cada 15 minutos en segundo plano." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Servidor de encuentro" Style="{StaticResource Heading}" FontSize="17" />
                        <Label Text="Solo ayuda a que dos teléfonos se encuentren. No guarda mensajes ni contactos. Cambiarlo requiere reiniciar la app." Style="{StaticResource Muted}" FontSize="13" />
                        <Border Padding="14,2" StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">
                            <Entry x:Name="EndpointEntry" Keyboard="Url" FontFamily="JetBrainsMono" FontSize="14" />
                        </Border>
                        <Button Text="Guardar servidor" Style="{StaticResource SecondaryButton}" Clicked="OnSaveEndpointClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Identidad de este teléfono" Style="{StaticResource Heading}" FontSize="17" />
                        <Label Text="{Binding IdentityFingerprint}" Style="{StaticResource Mono}" />
                        <Label Text="Si pierdes este teléfono, pierdes la identidad, los contactos y el historial: no hay copia en ningún servidor." Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" Style="{StaticResource Error}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
