<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Murmur.Presentation.ViewModels;assembly=Murmur.Presentation"
             xmlns:g="clr-namespace:Murmur.App.Graphics"
             x:Class="Murmur.App.Views.InvitePage"
             x:DataType="vm:InviteViewModel"
             Title="Mi código QR">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="10,24,10,8" ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Border Style="{StaticResource IconButton}" SemanticProperties.Description="Volver">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <g:Icon StrokeThickness="2.2" Data="M15 6L9 12L15 18" />
            </Border>
            <Label Grid.Column="1" Text="Mi código QR" Style="{StaticResource Heading}" FontSize="20" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,8,24,28" Spacing="20">
                <Label HorizontalTextAlignment="Center" Style="{StaticResource Muted}" FontSize="15">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Pide a la otra persona que lo escanee desde " />
                            <Span Text="Escanear" FontFamily="DMSansSemiBold" />
                            <Span Text=". Los dos necesitáis Internet." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Grid WidthRequest="300" HeightRequest="300" HorizontalOptions="Center">
                    <g:CountdownRing Fraction="{Binding RemainingFraction}" />
                    <Border WidthRequest="248" HeightRequest="248" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="14">
                        <Image x:Name="QrImage" SemanticProperties.Description="Código QR de invitación" />
                    </Border>
                    <Border WidthRequest="46" HeightRequest="46" BackgroundColor="{StaticResource Accent}" Stroke="White" StrokeThickness="5" StrokeShape="RoundRectangle 14">
                        <g:Icon Size="20" Stroke="White" StrokeThickness="2.8" Data="M6 10v4 M10 6v12 M14 8v8 M18 11v2" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="{Binding Remaining}" Style="{StaticResource Mono}" FontSize="30" HorizontalTextAlignment="Center" />
                    <Label Text="para que caduque · un solo uso" Style="{StaticResource Caption}" FontSize="13" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="16,14" StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Ellipse x:Name="WaitingDot" WidthRequest="12" HeightRequest="12" Fill="{StaticResource OnlineDot}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Status}" VerticalOptions="Center" FontSize="14" />
                    </Grid>
                </Border>

                <Button x:Name="RegenerateButton" Text="Generar un código nuevo" Style="{StaticResource SecondaryButton}" IsVisible="{Binding IsExpired}" Clicked="OnRegenerateClicked" />
                <Button x:Name="CopyButton" Text="Copiar invitación (solo desarrollo)" Style="{StaticResource SecondaryButton}" Clicked="OnCopyClicked" IsVisible="False" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <g:Icon Size="16" VerticalOptions="Start" Stroke="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" Data="M5 11h14v10H5z M8 11V8a4 4 0 0 1 8 0v3" />
                    <Label Grid.Column="1" Style="{StaticResource Caption}" Text="Solo contiene tu clave pública y un token de un solo uso. Muéstralo únicamente a quien quieres añadir." />
                </Grid>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" Style="{StaticResource Error}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
